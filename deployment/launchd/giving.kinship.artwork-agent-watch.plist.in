<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ARTWORK_MONITOR_ROOT_THREAD</key>
		<string>@ROOT_THREAD@</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>40</integer>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>giving.kinship.artwork-agent-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PYTHON@</string>
		<string>-B</string>
		<string>@FACTORY_ROOT@/agent-watch/manage.py</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@FACTORY_ROOT@/agent-watch/.runtime/watch.log</string>
	<key>StandardOutPath</key>
	<string>@FACTORY_ROOT@/agent-watch/.runtime/watch.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>WorkingDirectory</key>
	<string>@FACTORY_REPO@</string>
</dict>
</plist>
