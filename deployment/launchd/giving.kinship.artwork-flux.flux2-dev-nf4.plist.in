<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ARTWORK_FACTORY_STATE</key>
		<string>@FACTORY_STATE@</string>
		<key>ARTWORK_SSH_HOST</key>
		<string>@ARTWORK_SSH_HOST@</string>
		<key>ARTWORK_SSH_PORT</key>
		<string>@ARTWORK_SSH_PORT@</string>
		<key>ARTWORK_STATE</key>
		<string>@FACTORY_STATE@</string>
		<key>PATH</key>
		<string>@PATH@</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>950</integer>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>giving.kinship.artwork-flux.flux2-dev-nf4</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PYTHON@</string>
		<string>-B</string>
		<string>@FACTORY_ROOT@/artwork.py</string>
		<string>worker</string>
		<string>--backend</string>
		<string>command</string>
		<string>--model</string>
		<string>flux2-dev-nf4</string>
		<string>--concurrency</string>
		<string>1</string>
		<string>--argv</string>
		<string>@FACTORY_STATE@/flux-comparison/argv.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@FACTORY_STATE@/flux-comparison/worker-flux2-dev-nf4-primary-error.log</string>
	<key>StandardOutPath</key>
	<string>@FACTORY_STATE@/flux-comparison/worker-flux2-dev-nf4-primary.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>@FACTORY_ROOT@</string>
</dict>
</plist>
