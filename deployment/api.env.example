# Template only. Create a private file outside the checkout; never commit filled values.
ARTWORK_CONTROL_TOKEN=@RETAINED_CONTROL_TOKEN@
ARTWORK_SSH_KEY_B64=@BASE64_RESTRICTED_PRIVATE_KEY@
ARTWORK_SSH_HOST=@REPLACEMENT_HOSTNAME_WITHOUT_ROOT_AT@
ARTWORK_SSH_PORT=@SSH_PORT@
# Hex SHA-256 of decoded SSH Ed25519 public host-key blob, not OpenSSH display fingerprint.
ARTWORK_SSH_HOST_SHA256=@VERIFIED_HOST_KEY_HEX_SHA256@
ARTWORK_R2_ENDPOINT=@PRIVATE_R2_ENDPOINT@
ARTWORK_R2_BUCKET=@BUCKET@
ARTWORK_R2_ACCESS_KEY_ID=@SCOPED_ACCESS_KEY@
ARTWORK_R2_SECRET_ACCESS_KEY=@SCOPED_SECRET_KEY@
