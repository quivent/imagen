{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/studio.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/studio?__studio_path=/api/:path*" },
    { "source": "/data/:path*", "destination": "/api/studio?__studio_path=/data/:path*" },
    { "source": "/:record(tasks|agent-status|monitor-state|winners).json", "destination": "/api/studio?__studio_path=/:record.json" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/image-cache-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
