{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/studio.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/studio?__studio_path=/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "/api/studio?__studio_path=/data/:path*"
    },
    {
      "source": "/:record(tasks|agent-status|monitor-state|winners).json",
      "destination": "/api/studio?__studio_path=/:record.json"
    },
    {
      "source": "/stream",
      "destination": "/index.html"
    },
    {
      "source": "/compare",
      "destination": "/index.html"
    },
    {
      "source": "/controls",
      "destination": "/index.html"
    },
    {
      "source": "/tasks",
      "destination": "/index.html"
    },
    {
      "source": "/performance",
      "destination": "/index.html"
    },
    {
      "source": "/models",
      "destination": "/index.html"
    },
    {
      "source": "/seers",
      "destination": "/index.html"
    },
    {
      "source": "/worlds",
      "destination": "/index.html"
    },
    {
      "source": "/workbench",
      "destination": "/index.html"
    },
    {
      "source": "/metrics",
      "destination": "/index.html"
    },
    {
      "source": "/winners",
      "destination": "/index.html"
    },
    {
      "source": "/agents",
      "destination": "/index.html"
    },
    {
      "source": "/daemons",
      "destination": "/index.html"
    },
    {
      "source": "/rules",
      "destination": "/index.html"
    },
    {
      "source": "/protocol",
      "destination": "/index.html"
    },
    {
      "source": "/monitor",
      "destination": "/index.html"
    },
    {
      "source": "/stream/",
      "destination": "/index.html"
    },
    {
      "source": "/compare/",
      "destination": "/index.html"
    },
    {
      "source": "/controls/",
      "destination": "/index.html"
    },
    {
      "source": "/tasks/",
      "destination": "/index.html"
    },
    {
      "source": "/performance/",
      "destination": "/index.html"
    },
    {
      "source": "/models/",
      "destination": "/index.html"
    },
    {
      "source": "/seers/",
      "destination": "/index.html"
    },
    {
      "source": "/worlds/",
      "destination": "/index.html"
    },
    {
      "source": "/workbench/",
      "destination": "/index.html"
    },
    {
      "source": "/metrics/",
      "destination": "/index.html"
    },
    {
      "source": "/winners/",
      "destination": "/index.html"
    },
    {
      "source": "/agents/",
      "destination": "/index.html"
    },
    {
      "source": "/daemons/",
      "destination": "/index.html"
    },
    {
      "source": "/rules/",
      "destination": "/index.html"
    },
    {
      "source": "/protocol/",
      "destination": "/index.html"
    },
    {
      "source": "/monitor/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/image-cache-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
